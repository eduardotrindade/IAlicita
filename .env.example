# URL base da API do PNCP
VITE_PNCP_BASE_URL=

# SiliconFlow API (OpenAI-compatible)
VITE_AI_SILICONFLOW_KEY=
VITE_AI_SILICONFLOW_URL=https://api.siliconflow.cn/v1
VITE_AI_SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# AIML API (OpenAI-compatible)
VITE_AI_AIML_KEY=
VITE_AI_AIML_URL=https://api.aimlapi.com/v1
VITE_AI_AIML_MODEL=openai/gpt-4o-mini

# Hugging Face Inference API
VITE_AI_HF_KEY=
VITE_AI_HF_URL=https://api-inference.huggingface.co/models/
VITE_AI_HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# AI Provider ativo: siliconflow | aimlap | huggingface
VITE_AI_PROVIDER=siliconflow
