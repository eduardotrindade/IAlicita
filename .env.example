# PNCP
PNCP_BASE_URL=https://pncp.gov.br

# SiliconFlow API (OpenAI-compatible)
AI_SILICONFLOW_KEY=
AI_SILICONFLOW_URL=https://api.siliconflow.cn/v1
AI_SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# AIML API (OpenAI-compatible)
AI_AIML_KEY=
AI_AIML_URL=https://api.aimlapi.com/v1
AI_AIML_MODEL=openai/gpt-4o-mini

# Hugging Face Inference API
AI_HF_KEY=
AI_HF_URL=https://api-inference.huggingface.co/models/
AI_HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Active AI provider: siliconflow | aimlap | huggingface
AI_PROVIDER=siliconflow
